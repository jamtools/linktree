{
  "name": "linktree",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "npm run deploy:prepare && wrangler deploy --config .wrangler/deploy/wrangler.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250320.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1"
  }
}
